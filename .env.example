# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA vai para o Git.

# Conexão com o MySQL.
# Atenção: se a senha tiver @ : / # ou ?, ela precisa ir URL-encoded.
DATABASE_URL="mysql://USUARIO:SENHA@edumysql.acesso.rj.senac.br:3306/20252_tecweb3_vitorreis"

# Segredo usado para assinar os tokens JWT. Mínimo de 32 caracteres.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validade do token de acesso (ex.: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Porta onde a API sobe
PORT=3000
