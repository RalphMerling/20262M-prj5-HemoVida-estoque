// Schema do Prisma -- espelha as tabelas que JA EXISTEM no banco.
//
// Este arquivo nao cria nada. Ele descreve para o Prisma o que ja esta la.
// Os nomes dos modelos estao em ingles e no singular (convencao do Prisma);
// o @@map amarra cada um a tabela real, em portugues e no plural.
//
// Para conferir se este arquivo continua batendo com o banco:
//   npm run prisma:check

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  // A partir do Prisma 7 a connection string NAO fica mais aqui.
  // Ela vive em prisma.config.ts (para a CLI) e e passada ao PrismaClient
  // atraves do driver adapter (para a aplicacao).
  provider = "mysql"
}

model User {
  id             Int       @id @default(autoincrement())
  nome           String    @db.VarChar(120)
  email          String    @unique(map: "email") @db.VarChar(150)
  senha          String    @db.VarChar(120)
  dataNascimento DateTime? @db.Date
  rg             String?   @db.VarChar(20)
  cpf            String?   @unique(map: "cpf") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @db.DateTime(0)
  updatedAt      DateTime  @updatedAt @db.DateTime(0)
  nomeMae        String?   @default("Não informado") @map("NomeMae") @db.VarChar(255)
  role           String?   @default("user") @db.VarChar(50)

  enderecos Address[]
  contatos  Contact[]

  @@map("usuarios")
}

model Address {
  id          Int      @id @default(autoincrement())
  idUsuario   Int
  cep         String   @db.VarChar(20)
  rua         String   @db.VarChar(150)
  numero      String   @db.VarChar(20)
  complemento String?  @db.VarChar(100)
  bairro      String   @db.VarChar(100)
  cidade      String   @db.VarChar(100)
  estado      String   @db.VarChar(2)
  createdAt   DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @updatedAt @db.DateTime(0)

  usuario User @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "enderecos_ibfk_1")

  @@index([idUsuario], map: "idUsuario")
  @@map("enderecos")
}

model Contact {
  id             Int      @id @default(autoincrement())
  idUsuario      Int
  numeroTelefone String   @db.VarChar(30)
  createdAt      DateTime @default(now()) @db.DateTime(0)
  updatedAt      DateTime @updatedAt @db.DateTime(0)

  usuario User @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "contatos_ibfk_1")

  @@index([idUsuario], map: "idUsuario")
  @@map("contatos")
}
