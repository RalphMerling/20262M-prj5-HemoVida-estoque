
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

model Estoque {
  estoque_id           Int       @id @default(autoincrement())
  estoque_data_entrada DateTime  @db.DateTime(0)
  estoque_data_saida   DateTime? @db.DateTime(0)
  estoque_status       Int       @db.TinyInt
  bolsa_id             Int

  itens TransacaoItem[]

  @@map("estoque")
}

model Transacao {
  transacao_id     Int     @id
  transacao_tipo   String? @db.VarChar(45)
  solicitacao_id   Int?
  transacao_status Int

  itens TransacaoItem[]

  @@map("transacao")
}

model TransacaoItem {
  transacao_item_id         Int      @id @default(autoincrement())
  transacao_item_destino    String   @db.VarChar(45)
  transacao_item_data_saida DateTime @db.Date
  transacao_item_status     Int?     @db.TinyInt
  transacao_id              Int
  bolsa_id                  Int
  estoque_id                Int

  transacao Transacao @relation(fields: [transacao_id], references: [transacao_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_item_transacao_transacao1")

  estoque Estoque @relation(fields: [estoque_id], references: [estoque_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transacao_item_estoque1")

  @@index([transacao_id], map: "fk_item_transacao_transacao1_idx")
  @@index([estoque_id], map: "fk_transacao_item_estoque1_idx")

  @@map("transacao_item")
}
